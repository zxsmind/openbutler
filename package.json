{
  "name": "ranite",
  "version": "0.5.0",
  "type": "module",
  "description": "An agent that knows your machine.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "ranite": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-brand-assets.mjs && node scripts/copy-builtin-skills.mjs && node scripts/copy-terminal-host.mjs",
    "prepare": "npm run build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm --prefix web run typecheck && vitest run",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build:web": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.125",
    "@ai-sdk/cerebras": "^2.0.87",
    "@ai-sdk/cohere": "^3.0.68",
    "@ai-sdk/deepinfra": "^2.0.85",
    "@ai-sdk/gateway": "^3.0.212",
    "@ai-sdk/google": "^3.0.129",
    "@ai-sdk/groq": "^3.0.72",
    "@ai-sdk/mistral": "^3.0.70",
    "@ai-sdk/openai": "^3.0.121",
    "@ai-sdk/openai-compatible": "^2.0.80",
    "@ai-sdk/provider-utils": "^4.0.57",
    "@ai-sdk/togetherai": "^2.0.87",
    "@ai-sdk/xai": "^3.0.139",
    "@crosscopy/clipboard": "^0.3.6",
    "@huggingface/tokenizers": "^0.2.0",
    "@huggingface/transformers": "^4.3.0",
    "@inkjs/ui": "^2.0.0",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/client": "^2.3.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "ai": "^6.0.296",
    "beautiful-mermaid": "^1.1.3",
    "ink": "^8.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.12",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "1.23.2",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@secretlint/types": "^13.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "onnxruntime-node": "1.23.2"
  }
}
